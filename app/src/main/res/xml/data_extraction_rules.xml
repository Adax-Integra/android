<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Excludes the stored session from cloud backups. -->
        <exclude
            domain="sharedpref"
            path="session_preferences.xml" />
    </cloud-backup>

    <device-transfer>
        <!-- Prevents copying the session to another device. -->
        <exclude
            domain="sharedpref"
            path="session_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
